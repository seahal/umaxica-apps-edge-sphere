#!/usr/bin/env bash
set -euo pipefail

# Browser OAuth against Cloudflare. The callback lands on 127.0.0.1:8976 on the
# machine running this script. No API token is stored in this repository.
#
# `--device` switches to the Device Authorization Grant, which needs no inbound
# path at all — the CLI polls Cloudflare for the token instead of waiting for a
# browser redirect. That is the only flow that works over SSH or when the
# browser is not on this machine, because 8976 listens on loopback only.
# See docs/development/wrangler-authentication.md.
if [[ "${1:-}" == "--device" ]]; then
  exec pnpm exec wrangler login --device --no-browser --no-use-keyring
fi

exec pnpm exec wrangler login \
  --callback-host=0.0.0.0 \
  --callback-port=8976 \
  --no-use-keyring
