{
  "name": "umaxica-apps-edge-sphere",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "pnpm -r run format && vp fmt --config .oxfmtrc.json . --write",
    "format:check": "pnpm -r run format:check && vp fmt --config .oxfmtrc.json . --check",
    "lint": "pnpm -r run lint && vp lint --type-aware --fix .",
    "check:workers": "node tools/check-workers.mjs",
    "login": "scripts/wrangler-login",
    "login:device": "scripts/wrangler-login --device",
    "check:local": "scripts/check-local",
    "check:architecture": "depcruise --config .dependency-cruiser.jsonc --output-type err-long tools app/core/api org/core/api",
    "check:deps": "syncpack lint",
    "fix:deps": "syncpack fix",
    "check:spelling": "cspell lint --no-progress --gitignore --dot .",
    "check:size": "pnpm -r run check:size",
    "deploy:edge:preview": "scripts/deploy-edge-preview",
    "knip": "pnpm -r --workspace-concurrency=1 run knip",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --workspace-concurrency=4 run test && pnpm run test:repo",
    "test:repo": "EDGE_TRACKED_FILES=\"$(git ls-files)\" vp test run --dir test",
    "test:stress": "pnpm -r --workspace-concurrency=4 run test:stress && pnpm run test:repo:stress",
    "test:repo:stress": "EDGE_TRACKED_FILES=\"$(git ls-files)\" vp test run --dir test --sequence.shuffle",
    "test:api": "pnpm -r run test:api",
    "test:e2e": "pnpm -r run test:e2e",
    "prepare": "lefthook install",
    "build": "pnpm -r run build",
    "check": "pnpm run check:static && pnpm run test",
    "lint:fix": "pnpm -r run lint && vp lint --type-aware --fix .",
    "check:generated": "pnpm -r run check:generated",
    "check:static": "pnpm run format:check && pnpm run lint:check && pnpm run check:generated && pnpm run typecheck && pnpm run knip && pnpm run check:workers && pnpm run check:architecture && pnpm run check:deps && pnpm run check:spelling",
    "lint:check": "pnpm -r run lint:check && vp lint --type-aware ."
  },
  "devDependencies": {
    "@tanstack/intent": "catalog:",
    "@types/node": "catalog:",
    "cspell": "catalog:",
    "dependency-cruiser": "catalog:",
    "knip": "catalog:",
    "lefthook": "^2.2.2",
    "syncpack": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": "26.13.1"
  },
  "packageManager": "pnpm@12.18.0",
  "intent": {
    "skills": [
      "*"
    ]
  }
}
